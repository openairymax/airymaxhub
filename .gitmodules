[submodule "agent-workload"]
	path = agent-workload
	url = ../agent-workload.git
	branch = main
[submodule "agent-linux"]
	path = agent-linux
	url = ../agent-linux.git
	branch = main
[submodule "docs"]
	path = docs
	url = ../docs.git
	branch = main
[submodule "docs-closed"]
	path = docs-closed
	url = git@atomgit.com:openairymax/docs-closed.git
    branch = main
    update = none
[submodule "tools"]
	path = tools
	url = ../tools.git
	branch = main
# developbuild（发布工作区：离线包/install 快照/构建缓存）已迁出源码区，
# 现为伞仓同级 works-engineering/developbuild 独立仓（铁律：严禁在 airymaxhub
# 源码区内构建或存放构建产物）。构建/发布脚本经 AIRY_WORKSPACE 定位该目录。
