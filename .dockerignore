# =============================================================================
# AgentOS 项目根目录 .dockerignore
# 版本: 0.0.5
# 用途: 排除不需要包含在 Docker 构建上下文中的文件和目录
# ⚠️ 本文件位于项目根目录，因为 docker-compose.yml 使用 context: ..
# =============================================================================

# Git
.git
.gitignore
.gitattributes
.gitmodules

# IDE 和编辑器
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.c9/
.settings/
*.code-workspace

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.ruff_cache/

# 虚拟环境
.venv/
venv/
ENV/
env/
.conda/
conda/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# 测试
tests/
test/
coverage/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
mypy_cache/

# 构建产物
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.out
*.app
*.obj
*.pdb

# 数据和日志（不应进入镜像）
data/
logs/
*.log
*.db
*.sqlite3
*.sqlite

# 配置文件中的敏感信息（使用环境变量或 secrets）
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.dev
.env.test
config/local.yaml
config/production.yaml
**/secrets.yaml
**/*.key
**/*.pem
**/*.lic

# 文档和示例（减少镜像大小）
docs/
Docs/
DocsClosed/
examples/
README.md
README_zh.md
CHANGELOG.md
LICENSE
CONTRIBUTING.md
AUTHORS.md
NOTICE.md
SUPPORT.md
CODE_OF_CONDUCT.md

# 临时文件
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
.DS_Store
Thumbs.db
desktop.ini

# 调试文件
core
core.*
gmon.out
*.prof

# 大型依赖缓存
.cache/
.parcel-cache/
.next/
.out

# Docker 自身（避免嵌套构建）
docker-compose.override.yml
docker-compose.*.yml.local

# CI/CD 文件
.github/
.gitlab-ci.yml
Jenkinsfile
.travis.yml
.trivy.yml
.trivy.*

# 安全扫描报告
security-reports/
trivy-results.*

# 备份文件
backups/
*.tar.gz
*.sql.gz
*.rdb

# 归档文件
*.zip
*.tar
*.rar
*.7z

# 视频和大型媒体文件
*.mp4
*.avi
*.mov
*.mkv
*.iso

# 密钥和证书（仅Docker/目录内的受控文件应被复制）
**/*.p12
**/*.jks
**/*.keystore

# Tauri/Desktop 特定（不应进入后端镜像）
Desktop/src-tauri/target/
Desktop/src-tauri/bin/
Desktop/node_modules/
