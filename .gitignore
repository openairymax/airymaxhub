*.pyc
*.pyo
*.pyd
*.py[cod]
*$py.class
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# 虚拟环境
venv/
env/
ENV/
.python-version

