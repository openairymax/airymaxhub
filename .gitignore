# =============================================================================
# OpenAirymax 伞仓 .gitignore
# 版本：14.0.0
# 最后更新：2026-07-06
# 说明：29 仓拆分方案 — 伞仓直属文件 + 7 个 submodule
#
# 伞仓结构（v4.0 29 仓拆分方案）：
#   agentrt/      : 管理仓（核心运行底座，7 叶子仓 submodule）
#   sdk/          : 管理仓（多语言 SDK，6 叶子仓 submodule）
#   ecosystem/    : 管理仓（工程生态，5 叶子仓 submodule）
#   products/     : 管理仓（用户制品，3 叶子仓 submodule）
#   devtools/     : 顶层仓（开发工具）
#   docs/         : 顶层仓（开放文档）
#   docs-closed/  : 顶层仓（闭源管理文档）
#   cmake/        : 伞仓直属 CMake 模块（5 个 .cmake 文件，非 submodule）
# =============================================================================

# =============================================================================
# IDE 配置
# =============================================================================

.vscode/
.idea/
.vs/
.venv/
.trae/
*.code-workspace

# =============================================================================
# 构建输出目录（必须在源树外，BAN-33）
# =============================================================================

# 通用构建目录（必须在 /home/spharx/SpharxWorks/OpenAirymax 路径外）
build/
_build/
build-*/
cmake-build-*/
out/

# 各管理仓构建产物
agentrt-build/
AgentRT-build/
agentrt/ci-artifacts/
sdk-build/
ecosystem-build/
products-build/
devtools-build/
docs-build/
docs-closed-build/

# =============================================================================
# 运行时数据目录（daemon 运行时生成的内存/日志/检查点数据）
# =============================================================================

/data/
agentrt/data/
**/agentrt/memory/
**/agentrt/checkpoints/

# CTest 临时文件
Testing/
CTestTestfile.cmake
CTestTestfile.cmake.in

# Core dump 文件
core
core.*
*.core
vcore.*

# =============================================================================
# 依赖目录
# =============================================================================

node_modules/
**/node_modules/
vendor/

