# =============================================================================
# OpenAirymax 根目录 .gitignore
# 版本：12.1.0
# 最后更新：2026-06-19
# 说明：规范化排除所有不应纳入版本控制的文件和目录
#
# 项目结构（2026-06-19 当前）：
#   AgentRT/       : 智能体运行时核心（v0.1.1）
#   Desktop/       : 桌面客户端
#   Docker/        : Docker 镜像构建
#   Docs/          : 开放文档
#   DocsClosed/    : 内部文档（发行规划、标准规范、任务看板等）
#   MemoryRovol/   : 商业记忆模块（独立子仓库）
# =============================================================================

# =============================================================================
# IDE 配置
# =============================================================================

.vscode/
.idea/
.vs/
.venv/
.trae/
*.code-workspace

# =============================================================================
# 构建输出目录
# =============================================================================

# AgentRT 构建
AgentRT-build/
AgentRT-build-*/
AgentRT/ci-artifacts/

# Desktop 构建
Desktop-build/
Desktop/build/

# Docker 构建
Docker/build/
Docker/ci-artifacts/

# MemoryRovol 构建
MemoryRovol-build/
MemoryRovol/build/
MR-build/
MR-build-*/

# MemoryRovol 独立构建存根（本地生成，必排除）
AgentRT-stubs/

# 通用构建目录
build/
_build/
build-*/
cmake-build-*/
out/

